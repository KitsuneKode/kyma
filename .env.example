NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
# Prefer CLERK_FRONTEND_API_URL for Clerk + Convex. The JWT issuer domain is a fallback.
CLERK_FRONTEND_API_URL=
CLERK_JWT_ISSUER_DOMAIN=

NEXT_PUBLIC_CONVEX_URL=
# Generated by Convex bootstrap. Do not hand-edit unless you know why.
NEXT_PUBLIC_CONVEX_SITE_URL=
# Generated by Convex bootstrap. Do not hand-edit unless you know why.
CONVEX_DEPLOYMENT=

NEXT_PUBLIC_LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_WEBHOOK_API_KEY=
LIVEKIT_WEBHOOK_API_SECRET=
LIVEKIT_AGENT_NAME=tutor-screener
LIVEKIT_AGENT_STT_MODEL=deepgram/nova-3
LIVEKIT_AGENT_LLM_MODEL=openai/gpt-4.1-mini
LIVEKIT_AGENT_TTS_MODEL=cartesia/sonic
LIVEKIT_AGENT_CHILD_TTS_MODEL=
LIVEKIT_AGENT_WRAP_TTS_MODEL=
LIVEKIT_AGENT_INSTRUCTIONS=
LIVEKIT_AGENT_CHILD_INSTRUCTIONS=
LIVEKIT_AGENT_WRAP_UP_INSTRUCTIONS=
LIVEKIT_AGENT_LOG_LEVEL=info
LIVEKIT_RECORDING_ENABLED=0
LIVEKIT_RECORDING_AUDIO_ONLY=0
LIVEKIT_RECORDING_TEMPLATE_URL=
LIVEKIT_RECORDING_STORAGE_BUCKET=
LIVEKIT_RECORDING_STORAGE_REGION=
LIVEKIT_RECORDING_STORAGE_ACCESS_KEY=
LIVEKIT_RECORDING_STORAGE_SECRET_KEY=
KYMA_AGENT_REALTIME_PROVIDER=cascade
KYMA_AGENT_VIDEO_INPUT=0
NEXT_PUBLIC_ENABLE_DEV_TRACE=0
NEXT_PUBLIC_APP_URL=

# Provider keys (platform BYOK). GOOGLE_API_KEY is preferred; GEMINI_API_KEY is a compatibility alias.
OPENAI_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Deployment mode. REQUIRED on the Convex production deployment.
# NODE_ENV defaults to "development" when unset, so dev-seed/reset guards and
# processing-key fallbacks treat an unset value as untrusted rather than as
# production. Set BOTH of these on any non-development Convex deployment.
KYMA_DEPLOYMENT_ENV=development
# NODE_ENV=production   # set on the Convex production deployment
KYMA_REVIEW_CHAT_MODEL=
KYMA_AUTH_DEBUG=0
# Manual org plan override (design partners / emergencies). Prefer Dodo billing.
# Valid values: free | pro | enterprise.
KYMA_ORG_PLAN_OVERRIDE=

# Dodo Payments (https://docs.dodopayments.com) — subscription billing.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_RETURN_URL=
DODO_PAYMENTS_PRODUCT_PRO_MONTHLY=
DODO_PAYMENTS_PRODUCT_PRO_YEARLY=
DODO_PAYMENTS_PRODUCT_ENTERPRISE_MONTHLY=
DODO_PAYMENTS_PRODUCT_ENTERPRISE_YEARLY=

# Platform/tooling (usually injected; documented for local parity)
VERCEL_URL=

KYMA_SCORING_MODEL=
# Required in production for report write authentication.
KYMA_PROCESSING_WRITE_KEY=
KYMA_ADMIN_EMAILS=
# Required to store/decrypt workspace BYOK provider keys (openssl rand -hex 32).
KYMA_ENCRYPTION_KEY=

INNGEST_APP_ID=kyma
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Optional transactional email (Resend). Without RESEND_API_KEY, sendEmail logs in
# development and no-ops in production. See .docs/email-notifications.md.
RESEND_API_KEY=
EMAIL_FROM=

# Optional error reporting. Wire `@sentry/nextjs` separately; see lib/ops/error-reporting.ts.
SENTRY_DSN=
