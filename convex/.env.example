# Convex deployment env (set via `npx convex env set` or Dashboard)
# Seed from local app env with: ./scripts/convex-local-setup.sh

KYMA_DEPLOYMENT_ENV=development
KYMA_PROCESSING_WRITE_KEY=
KYMA_ENCRYPTION_KEY=
KYMA_ADMIN_EMAILS=
# Manual plan override (free|pro|enterprise). Prefer Dodo billing on organizations.
KYMA_ORG_PLAN_OVERRIDE=

# Post-call processing is enqueued on Inngest from the Convex finalize path.
# INNGEST_EVENT_KEY is required in production; without it, processing falls back
# to inline (dev only). Override the base URL for the local Inngest dev server
# (e.g. http://localhost:8288); defaults to the cloud endpoint (https://inn.gs).
INNGEST_EVENT_KEY=
INNGEST_EVENT_API_BASE_URL=

CLERK_SECRET_KEY=
CLERK_FRONTEND_API_URL=
CLERK_JWT_ISSUER_DOMAIN=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
