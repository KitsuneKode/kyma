{
  "name": "kyma",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run dev:web",
    "dev:web": "next dev --turbopack",
    "dev:stack": "env -u NO_COLOR FORCE_COLOR=1 concurrently -n convex,web -c \"bgBlue.bold,bgMagenta.bold\" -p \"[{time} {name}]\" -t \"HH:mm:ss\" --pad-prefix --kill-others-on-fail \"bun run convex:dev\" \"bun run dev:web\"",
    "dev:full": "env -u NO_COLOR FORCE_COLOR=1 concurrently -n convex,web,agent -c \"bgBlue.bold,bgMagenta.bold,bgGreen.bold\" -p \"[{time} {name}]\" -t \"HH:mm:ss\" --pad-prefix --kill-others-on-fail \"bun run convex:dev\" \"bun run dev:web\" \"bun run agent:dev\"",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "check": "bun run fmt:check && bun run lint && bun run test && bun run convex:ci && git diff --exit-code -- convex/_generated && bunx next typegen && bun run typecheck && bun run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "knip": "knip --no-progress",
    "test:e2e": "playwright test",
    "lint:staged": "lint-staged",
    "commitlint": "commitlint --edit",
    "convex:dev": "CONVEX_AGENT_MODE=anonymous bunx convex dev",
    "convex:once": "CONVEX_AGENT_MODE=anonymous bunx convex dev --once",
    "convex:sync-env": "bash scripts/convex-local-setup.sh",
    "convex:sync-env:prod": "bash scripts/convex-local-setup.sh --prod",
    "convex:ci": "CONVEX_AGENT_MODE=anonymous bunx convex init && CONVEX_AGENT_MODE=anonymous bunx convex env set < .env.convex-ci && CONVEX_AGENT_MODE=anonymous bunx convex dev --once",
    "db:reset:dev": "bunx convex run devSeed:resetDevData '{\"confirm\":\"RESET_DEV_ONLY\"}'",
    "db:seed:dev": "bunx convex run devSeed:seedDevData '{\"confirm\":\"SEED_DEV_ONLY\"}'",
    "db:cutover:org-rbac:dev": "bun run db:reset:dev && bun run db:seed:dev",
    "clerk:setup-auth": "bun run scripts/clerk-setup-kyma-auth.ts",
    "brand:export": "bun run scripts/export-brand-pngs.ts",
    "readme:capture": "node scripts/capture-readme-screenshots.mjs",
    "verify:auth-org-rbac": "bun run fmt:check && bun run typecheck && bun run lint && bun run test",
    "agent:dev": "bun run agents/worker.ts dev",
    "agent:start": "bun run agents/worker.ts start",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1073.0",
    "@aws-sdk/s3-request-presigner": "^3.1073.0",
    "@base-ui/react": "^1.5.0",
    "@clerk/nextjs": "^7.4.3",
    "@convex-dev/rate-limiter": "^0.3.2",
    "@livekit/agents": "^1.4.5",
    "@livekit/agents-plugin-google": "^1.4.8",
    "@livekit/agents-plugin-openai": "^1.4.8",
    "@livekit/components-react": "^2.9.21",
    "@livekit/components-styles": "^1.2.0",
    "@livekit/protocol": "^1.40.0",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@t3-oss/env-core": "^0.13.11",
    "@t3-oss/env-nextjs": "^0.13.8",
    "@tabler/icons-react": "^3.44.0",
    "@tanstack/react-table": "^8.21.3",
    "ai": "^6.0.198",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.40.0",
    "convex-helpers": "^0.1.119",
    "date-fns": "^4.4.0",
    "inngest": "^4.5.0",
    "livekit-client": "^2.19.2",
    "livekit-server-sdk": "^2.15.4",
    "liveline": "^0.0.7",
    "motion": "^12.40.0",
    "next": "16.2.7",
    "next-themes": "^0.4.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "3.8.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@edge-runtime/vm": "^5.0.0",
    "@faker-js/faker": "^10.4.0",
    "@playwright/test": "^1.60.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^10.0.3",
    "convex-test": "^0.0.53",
    "husky": "^9.1.7",
    "knip": "^5.85.0",
    "lint-staged": "^17.0.7",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.69.0",
    "postcss": "^8.5.15",
    "shadcn": "^4.11.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
